# ============================================================
# SurveyOS — Environment Variables
# Copy this to .env.local and fill in your values
# ============================================================

# --- Supabase ---
# Get these from: https://supabase.com/dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://ftntwcwrfqwkhlhapbly.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_lGxywS4S9TKH2zdYeJNh8A_HB0wZ9n6

NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key





# Direct database connection (for Drizzle migrations)
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres.[your-project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Retell AI (Voice Agent) ---
# Get these from: https://www.retellai.com/dashboard
RETELL_API_KEY=key_...
RETELL_AGENT_ID=agent_...
# The phone number Retell assigns to your agent
RETELL_PHONE_NUMBER=+15125550100
# Secret for verifying webhook signatures
RETELL_WEBHOOK_SECRET=whsec_...

# --- Stripe (Payments) ---
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Twilio (SMS) ---
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+15125550200

# --- Resend (Email) ---
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...
# The "from" address for transactional emails (must verify domain in Resend)
EMAIL_FROM=notifications@yourdomain.com

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Used for signing internal tokens (e.g., proposal acceptance links)
APP_SECRET=generate-a-random-32-char-string-here
